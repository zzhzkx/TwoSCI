{
  "name": "twosci",
  "version": "0.3.2",
  "description": "TwoSCI: seed-paper-driven literature research MCP server and plugin for Codex and Claude Code.",
  "main": "dist/server.js",
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "README-sc.md",
    "LICENSE",
    ".env.example"
  ],
  "type": "module",
  "bin": {
    "twosci": "dist/server.js"
  },
  "scripts": {
    "build": "npm run clean && npx tsc",
    "build:plugin": "npm run build && node scripts/build-plugin.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prepack": "npm run build",
    "benchmark:offline": "tsx scripts/retrieval-benchmark.ts",
    "benchmark:live": "tsx scripts/retrieval-benchmark.ts --live",
    "start": "node dist/server.js",
    "start:mcp": "tsx src/server.ts",
    "dev": "tsx src/server.ts",
    "test": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js",
    "check": "npx tsc --noEmit && npm run lint && npm test -- --runInBand && npm pack --dry-run",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "academic-papers",
    "literature-review",
    "two-sci",
    "research",
    "arxiv",
    "pubmed",
    "web-of-science",
    "ieee-xplore",
    "nodejs",
    "typescript"
  ],
  "author": "zzhzkx",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/cheerio": "^0.22.35",
    "adm-zip": "^0.6.1",
    "axios": "^1.21.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "https-proxy-agent": "^7.0.6",
    "lru-cache": "^11.2.5",
    "p-limit": "^7.2.0",
    "patchright": "^1.64.3",
    "pdf-parse": "^1.1.4",
    "socks-proxy-agent": "^8.0.5",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jest": "^29.5.14",
    "@types/lru-cache": "^7.10.9",
    "@types/node": "^20.14.10",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(p-limit|yocto-queue)/)"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/plugin/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "overrides": {
    "entities": "^6.0.0"
  },
  "engines": {
    "node": ">=20.18.1 <21 || >=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzhzkx/TwoSCI.git"
  },
  "homepage": "https://github.com/zzhzkx/TwoSCI#readme",
  "bugs": {
    "url": "https://github.com/zzhzkx/TwoSCI/issues"
  }
}
